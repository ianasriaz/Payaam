# AWS & Bedrock Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
BEDROCK_MODEL_SONNET=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_HAIKU=anthropic.claude-3-5-haiku-20241022-v1:0

# DynamoDB Tables
DYNAMODB_TABLE_USERS=Payaam_Users
DYNAMODB_TABLE_MISSIONS=Payaam_Missions
DYNAMODB_TABLE_REGISTRY=Payaam_ContactRegistry

# Purelymail SMTP & IMAP Configuration
PURELYMAIL_SMTP_HOST=smtp.purelymail.com
PURELYMAIL_SMTP_PORT=465
PURELYMAIL_IMAP_HOST=imap.purelymail.com
PURELYMAIL_IMAP_PORT=993
PURELYMAIL_USER=payaam@yourdomain.com
PURELYMAIL_PASSWORD=your_purelymail_password
PURELYMAIL_DEFAULT_FROM=payaam@yourdomain.com

# Security: Fernet Encryption Key for User SMTP Passwords at Rest (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
APP_ENCRYPTION_KEY=your_32_byte_base64_fernet_key

# App & Guardrail Settings
COLLISION_COOLDOWN_DAYS=14
MAX_OUTREACH_TARGETS=5
SESSION_TTL_HOURS=72
